meta {
  name: Chat Completion
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/chat/completions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-BF16",
    "messages": [
      {
        "role": "user",
        "content": "Hello, what can you help me with?"
      }
    ],
    "max_tokens": 512,
    "temperature": 0.7
  }
}

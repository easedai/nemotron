# ── Provider selection ────────────────────────────────────────────────────────
# One or more providers, comma-separated.
# Options: vastai | runpod | lambdalabs | tensordock | salad
# Mix freely, e.g. "vastai,runpod" to bid across both marketplaces simultaneously.
# PROVIDERS=vastai

# ── vast.ai ───────────────────────────────────────────────────────────────────
VASTAI_API_KEY=your_vastai_api_key_here

# ── RunPod ────────────────────────────────────────────────────────────────────
# Required when PROVIDERS includes "runpod"
RUNPOD_API_KEY=your_runpod_api_key_here

# ── Lambda Labs ───────────────────────────────────────────────────────────────
# Required when PROVIDERS includes "lambdalabs"
LAMBDALABS_API_KEY=your_lambdalabs_api_key_here
# Name of a pre-registered SSH key in Lambda Labs (optional — needed for SSH log collection)
# Register the key at cloud.lambdalabs.com → SSH Keys, then paste the name here.
# LAMBDALABS_SSH_KEY_NAME=my-key

# ── TensorDock ────────────────────────────────────────────────────────────────
# Required when PROVIDERS includes "tensordock"
TENSORDOCK_API_KEY=your_tensordock_api_key_here
TENSORDOCK_ORG_ID=your_tensordock_org_id_here
# RAM (GB) to allocate per VM. 32 GB is the minimum for Nemotron-Nano-12B.
# TENSORDOCK_RAM_GB=32

# ── Salad ─────────────────────────────────────────────────────────────────────
# Required when PROVIDERS includes "salad"
SALAD_API_KEY=your_salad_api_key_here
SALAD_ORG_NAME=your-organization-name
SALAD_PROJECT_NAME=your-project-name
# Priority tier — controls reliability vs cost. Options: batch | low | medium | high
# SALAD_PRIORITY=high
# CPU cores and RAM per container replica (adjust for your GPU class)
# SALAD_CONTAINER_CPU=4
# SALAD_CONTAINER_MEMORY_MB=30720

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Your AWS SSO profile name (from ~/.aws/config).
# Run `aws sso login --profile <name>` on the host before `docker compose up`.
# In production (ECS Fargate) leave this unset — the task IAM role is used instead.
AWS_PROFILE=your-sso-profile-name
DYNAMODB_TABLE=eased-workers
HISTORY_TABLE=eased-workers-history
EVENTS_TABLE=eased-instance-events
LB_WORKERS_TABLE=eased-lb-workers

# ── Redis (worker queue) ──────────────────────────────────────────────────────
# Single-node Redis used as the LB round-robin queue and worker metadata store.
# DynamoDB is retained for orchestrator state and request stats only.
REDIS_URL=redis://localhost:6379/0
# How long (seconds) an LB holds a worker lease before Redis auto-expires it.
# Protects against a crashed LB leaving a worker permanently checked out.
# REDIS_LEASE_TTL_SEC=300
# Override the LB instance identity used in lease tracking.
# Defaults to the Docker container hostname (short container ID).
# LB_INSTANCE_ID=lb-prod-1

# ── Admin auth ────────────────────────────────────────────────────────────────
# Bearer token required on all /admin/* endpoints.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=your_admin_token_here

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANNEL_ID/TOKEN

# ── Worker image ──────────────────────────────────────────────────────────────
# Built by .github/workflows/build-worker.yml and pushed to Docker Hub.
WORKER_IMAGE=easedai/nemotron-vastai:latest

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_ID=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-BF16

# ── HuggingFace cache ─────────────────────────────────────────────────────────
# Must match HF_HOME baked into worker/Dockerfile (ENV HF_HOME=/hf).
# vLLM resolves MODEL_ID to the cached weights at $HF_HOME/hub/ automatically.
HF_HOME=/hf
HF_HUB_ENABLE_HF_TRANSFER=1

# ── vLLM cache ────────────────────────────────────────────────────────────────
# Where vLLM stores compiled Triton kernels and torch.compile artifacts.
VLLM_CACHE_ROOT=/vllm-cache

# ── vLLM tuning ───────────────────────────────────────────────────────────────
VLLM_PORT=8080
VLLM_VIDEO_LOADER_BACKEND=opencv
# >= 40 GB GPU  ->  VLLM_MAX_MODEL_LEN=32768  (default)
# >= 80 GB GPU  ->  VLLM_MAX_MODEL_LEN=131072 (full video context)
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.95

# ── Bidding tuning (optional — defaults shown) ────────────────────────────────
# BID_START_PCT=0.50
# BID_STEP_PCT=0.05
# BID_RETRY_INTERVAL_SEC=300
# BID_MAX_MULTIPLIER=1.10

# ── GPU requirements (optional — defaults shown) ──────────────────────────────
# 40 GB minimum: model weights ~24 GB leaves headroom for KV cache
# MIN_GPU_RAM_GB=40
# MIN_DISK_GB=100
# MIN_INET_DOWN_MBPS=300
# MIN_RELIABILITY=0.90
# Per-GPU free VRAM floor: filters out cards where (1 - utilization) × gpu_ram < this.
# At VLLM_GPU_MEMORY_UTILIZATION=0.95 a 24 GB card leaves only 1.2 GB — causes OOM.
# With the default 0.90 utilization, MIN_GPU_OVERHEAD_GB=2.0 requires >= 20 GB per card.
# MIN_GPU_OVERHEAD_GB=2.0

# ── Instance limits (optional — defaults shown) ───────────────────────────────
# MAX_INSTANCES=1
# MIN_INSTANCES=1
# KEEP_DEBUG_INSTANCE=false

# ── Auto-scaling (optional — defaults shown) ──────────────────────────────────
# Fraction of workers that must be busy (leased) to count as a saturated tick.
# SCALE_UP_THRESHOLD=0.8
# Consecutive saturated ticks before bidding for an extra worker.
# SCALE_UP_CONSECUTIVE_TICKS=3
# Seconds to wait after a scale-up before considering another (cold start ~10–15 min).
# SCALE_UP_COOLDOWN_SEC=600
# Seconds idle (no completed requests) before a worker is eligible for termination.
# SCALE_DOWN_IDLE_SEC=600
# Consecutive ticks with idle workers before actually terminating one (hysteresis).
# SCALE_DOWN_CONSECUTIVE_TICKS=5

# ── SSH (orchestrator + LB debug logs) ───────────────────────────────────────
# Private key used to SSH into vast.ai workers for log collection on 5xx errors.
# Paste the PEM block with literal \n newlines (one long line), e.g.:
#   ORCHESTRATOR_SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\nAAAA...\n-----END OPENSSH PRIVATE KEY-----
# Generate with: ssh-keygen -t ed25519 -f ~/.ssh/eased_worker -N ""
# Then register the public key in vast.ai account settings.
ORCHESTRATOR_SSH_PRIVATE_KEY=

# ── Identity ─────────────────────────────────────────────────────────────────
# Prefixed on Discord notifications so local dev is visually distinct from prod.
# ORCHESTRATOR_ID=local

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

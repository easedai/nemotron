# ── Required ──────────────────────────────────────────────────────────────────
API_KEY=your-secret-api-key

# ── HuggingFace (needed to pull unsloth/Qwen3-VL-8B-Instruct) ────────────────
HF_TOKEN=hf_...

# ── Adapter ───────────────────────────────────────────────────────────────────
# Local path to your Unsloth/PEFT LoRA checkpoint (host-side mount source).
# Must contain adapter_config.json + adapter_model.safetensors.
ADAPTER_PATH=./adapters/checkpoint

# Name the adapter is served under — used in API requests as the model name.
LORA_NAME=caption

# ── Model / vLLM ──────────────────────────────────────────────────────────────
BASE_MODEL=unsloth/Qwen3-VL-8B-Instruct
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
MAX_LORA_RANK=64

# ── GHCR ──────────────────────────────────────────────────────────────────────
GHCR_ORG=myorg
